# Copy to .env.local for local development. No credentials are needed for the mock MVP.

# Flight data provider: "mock" (default). "amadeus" is reserved for a later task.
FLIGHT_PROVIDER=mock

# Artificial latency (ms) for the mock provider, to make the loading state visible.
MOCK_LATENCY_MS=400

# Amadeus Self-Service credentials (NOT used yet - placeholders for the next task).
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_HOSTNAME=test
